{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "mirror: build debug",
      "type": "process",
      "command": "${env:USERPROFILE}/.cargo/bin/cargo.exe",
      "args": ["build"],
      "options": { "cwd": "${workspaceFolder}/apps/mirror" },
      "problemMatcher": ["$rustc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "mirror: build release",
      "type": "process",
      "command": "${env:USERPROFILE}/.cargo/bin/cargo.exe",
      "args": ["build", "--release"],
      "options": { "cwd": "${workspaceFolder}/apps/mirror" },
      "problemMatcher": ["$rustc"],
      "group": "build"
    },
    {
      "label": "mirror: test",
      "type": "process",
      "command": "${env:USERPROFILE}/.cargo/bin/cargo.exe",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}/apps/mirror" },
      "problemMatcher": ["$rustc"],
      "group": "test"
    }
  ]
}
